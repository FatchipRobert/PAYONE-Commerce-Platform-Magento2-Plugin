<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <!-- Checkout input → payment additional_information (keys in the PayoneCP<Method>DataAssignObserver virtualTypes in di.xml) -->
    <event name="payment_method_assign_data_payone_cp_creditcard">
        <observer name="payone_cp_creditcard_data_assign" instance="PayoneCPCreditcardDataAssignObserver" />
    </event>
    <event name="payment_method_assign_data_payone_cp_directdebit">
        <observer name="payone_cp_directdebit_data_assign" instance="PayoneCPDirectDebitDataAssignObserver" />
    </event>
    <event name="payment_method_assign_data_payone_cp_googlepay">
        <observer name="payone_cp_googlepay_data_assign" instance="PayoneCPGooglePayDataAssignObserver" />
    </event>
    <event name="sales_order_payment_capture">
        <observer name="payone_cp_order_payment_capture" instance="Payone\CommercePlatform\Observer\OrderPaymentCapture" />
    </event>
    <event name="payone_cp_webhook_all">
        <observer name="payone_cp_webhook_all" instance="Payone\CommercePlatform\Observer\Webhook\All" />
    </event>
    <event name="payone_cp_webhook_payment_captured">
        <observer name="payone_cp_webhook_payment_captured" instance="Payone\CommercePlatform\Observer\Webhook\Captured" />
    </event>
</config>
