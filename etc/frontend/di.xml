<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <type name="Magento\Checkout\Model\CompositeConfigProvider">
        <arguments>
            <argument name="configProviders" xsi:type="array">
                <item name="payone_cp_config_provider" xsi:type="object">Payone\CommercePlatform\Model\Ui\ConfigProvider</item>
                <item name="payone_cp_creditcard_config_provider" xsi:type="object">Payone\CommercePlatform\Model\Ui\CreditcardConfigProvider</item>
                <item name="payone_cp_directdebit_config_provider" xsi:type="object">Payone\CommercePlatform\Model\Ui\DirectDebitConfigProvider</item>
                <item name="payone_cp_googlepay_config_provider" xsi:type="object">Payone\CommercePlatform\Model\Ui\GooglePayConfigProvider</item>
                <item name="payone_cp_applepay_config_provider" xsi:type="object">Payone\CommercePlatform\Model\Ui\ApplePayConfigProvider</item>
                <item name="payone_cp_securedinvoice_config_provider" xsi:type="object">PayoneCPSecuredInvoiceConfigProvider</item>
                <item name="payone_cp_secureddirectdebit_config_provider" xsi:type="object">PayoneCPSecuredDirectDebitConfigProvider</item>
            </argument>
        </arguments>
    </type>
    <virtualType name="PayoneCPSecuredInvoiceConfigProvider" type="Payone\CommercePlatform\Model\Ui\BnplConfigProvider">
        <arguments>
            <argument name="methodCode" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_SECURED_INVOICE</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPSecuredDirectDebitConfigProvider" type="Payone\CommercePlatform\Model\Ui\BnplConfigProvider">
        <arguments>
            <argument name="methodCode" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_SECURED_DIRECT_DEBIT</argument>
        </arguments>
    </virtualType>
</config>
