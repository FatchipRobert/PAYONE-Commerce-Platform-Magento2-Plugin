<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Payone\CommercePlatform\Api\ClickToPayInterface" type="Payone\CommercePlatform\Service\V1\ClickToPay" />
    <preference for="Payone\CommercePlatform\Api\Data\ClickToPayResponseInterface" type="Payone\CommercePlatform\Service\V1\Data\ClickToPayResponse" />

    <!-- START - PAYMENT CONFIG -->
    <type name="Payone\CommercePlatform\Model\Method\BaseMethod">
        <arguments>
            <!-- A default code has to be set here - correct code is set in the constructor -->
            <argument name="code" xsi:type="string">Payone\CommercePlatform\Model\Payone::METHOD_CREDITCARD</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Magento\Payment\Block\Info</argument>
        </arguments>
    </type>

    <!-- START - EVERY PAYMENT METHOD NEEDS ONE OF THESE BLOCKS -->
    <!-- Creditcard Config Handler -->
    <type name="Payone\CommercePlatform\Model\Method\Creditcard">
        <arguments>
            <argument name="valueHandlerPool" xsi:type="object">PayoneCPValueHandlerPoolCreditcard</argument>
        </arguments>
    </type>
    <virtualType name="PayoneCPValueHandlerPoolCreditcard" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">PayoneCPConfigValueHandlerCreditcard</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPConfigValueHandlerCreditcard" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">PayoneCPCreditcardVaultPaymentConfigCreditcard</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPCreditcardVaultPaymentConfigCreditcard" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_CREDITCARD</argument>
        </arguments>
    </virtualType>
    <!-- END - EVERY PAYMENT METHOD NEEDS ONE OF THESE BLOCKS... -->

    <!-- Direct Debit Config Handler -->
    <type name="Payone\CommercePlatform\Model\Method\DirectDebit">
        <arguments>
            <argument name="valueHandlerPool" xsi:type="object">PayoneCPValueHandlerPoolDirectDebit</argument>
        </arguments>
    </type>
    <virtualType name="PayoneCPValueHandlerPoolDirectDebit" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">PayoneCPConfigValueHandlerDirectDebit</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPConfigValueHandlerDirectDebit" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">PayoneCPVaultPaymentConfigDirectDebit</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPVaultPaymentConfigDirectDebit" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_DIRECT_DEBIT</argument>
        </arguments>
    </virtualType>
    <!-- PayPal Config Handler -->
    <type name="Payone\CommercePlatform\Model\Method\PayPal">
        <arguments>
            <argument name="valueHandlerPool" xsi:type="object">PayoneCPValueHandlerPoolPayPal</argument>
        </arguments>
    </type>
    <virtualType name="PayoneCPValueHandlerPoolPayPal" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">PayoneCPConfigValueHandlerPayPal</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPConfigValueHandlerPayPal" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">PayoneCPVaultPaymentConfigPayPal</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPVaultPaymentConfigPayPal" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_PAYPAL</argument>
        </arguments>
    </virtualType>
    <!-- Google Pay Config Handler -->
    <type name="Payone\CommercePlatform\Model\Method\GooglePay">
        <arguments>
            <argument name="valueHandlerPool" xsi:type="object">PayoneCPValueHandlerPoolGooglePay</argument>
        </arguments>
    </type>
    <virtualType name="PayoneCPValueHandlerPoolGooglePay" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">PayoneCPConfigValueHandlerGooglePay</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPConfigValueHandlerGooglePay" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">PayoneCPVaultPaymentConfigGooglePay</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPVaultPaymentConfigGooglePay" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_GOOGLEPAY</argument>
        </arguments>
    </virtualType>
    <!-- END - PAYMENT CONFIG -->

    <!-- START - SERVICE COMMANDS (API calls outside of payment operations, return an ArrayResult) -->
    <virtualType name="PayoneCPServiceCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="get_jwt" xsi:type="string">PayoneCPGetJwtCommand</item>
                <item name="get_checkout_details" xsi:type="string">PayoneCPGetCheckoutDetailsCommand</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="PayoneCPGetJwtCommand" type="Payone\CommercePlatform\Gateway\Command\ResultCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">Payone\CommercePlatform\Gateway\Request\GetJwtBuilder</argument>
            <argument name="transferFactory" xsi:type="object">PayoneCPGetJwtTransferFactory</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPGetJwtTransferFactory" type="Payone\CommercePlatform\Gateway\Http\TransferFactory">
        <arguments>
            <argument name="endpoint" xsi:type="string">/v1/{merchantId}/authentication-tokens</argument>
            <argument name="httpMethod" xsi:type="string">POST</argument>
            <argument name="requestName" xsi:type="string">GetJWT</argument>
        </arguments>
    </virtualType>

    <virtualType name="PayoneCPGetCheckoutDetailsCommand" type="Payone\CommercePlatform\Gateway\Command\ResultCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">Payone\CommercePlatform\Gateway\Request\GetCheckoutDetailsBuilder</argument>
            <argument name="transferFactory" xsi:type="object">PayoneCPGetCheckoutDetailsTransferFactory</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPGetCheckoutDetailsTransferFactory" type="Payone\CommercePlatform\Gateway\Http\TransferFactory">
        <arguments>
            <argument name="endpoint" xsi:type="string">/v1/{merchantId}/commerce-cases/{commerceCaseId}/checkouts/{checkoutId}</argument>
            <argument name="httpMethod" xsi:type="string">GET</argument>
            <argument name="requestName" xsi:type="string">GetCheckoutDetails</argument>
        </arguments>
    </virtualType>

    <type name="Payone\CommercePlatform\Service\V1\ClickToPay">
        <arguments>
            <argument name="commandPool" xsi:type="object">PayoneCPServiceCommandPool</argument>
        </arguments>
    </type>
    <type name="Payone\CommercePlatform\Controller\Onepage\Returned">
        <arguments>
            <argument name="commandPool" xsi:type="object">PayoneCPServiceCommandPool</argument>
        </arguments>
    </type>
    <!-- END - SERVICE COMMANDS -->

    <virtualType name="Payone\CommercePlatform\Model\ResourceModel\ApiLog\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">payone_cp_protocol_api</argument>
            <argument name="resourceModel" xsi:type="string">Payone\CommercePlatform\Model\ResourceModel\ApiLog</argument>
        </arguments>
    </virtualType>
    <virtualType name="Payone\CommercePlatform\Model\ResourceModel\WebhookMessage\Grid\Collection" type="Magento\Framework\View\Element\UiComponent\DataProvider\SearchResult">
        <arguments>
            <argument name="mainTable" xsi:type="string">payone_cp_protocol_webhook</argument>
            <argument name="resourceModel" xsi:type="string">Payone\CommercePlatform\Model\ResourceModel\WebhookMessage</argument>
        </arguments>
    </virtualType>
    <type name="Magento\Config\Model\Config\TypePool">
        <arguments>
            <argument name="sensitive" xsi:type="array">
                <item name="payone_cp_general/global/api_secret" xsi:type="string">1</item>
            </argument>
        </arguments>
    </type>
    <type name="Magento\Framework\View\Element\UiComponent\DataProvider\CollectionFactory">
        <arguments>
            <argument name="collections" xsi:type="array">
                <item name="payone_cp_protocol_api_grid_data_source" xsi:type="string">Payone\CommercePlatform\Model\ResourceModel\ApiLog\Grid\Collection</item>
                <item name="payone_cp_protocol_webhook_grid_data_source" xsi:type="string">Payone\CommercePlatform\Model\ResourceModel\WebhookMessage\Grid\Collection</item>
            </argument>
        </arguments>
    </type>
</config>
