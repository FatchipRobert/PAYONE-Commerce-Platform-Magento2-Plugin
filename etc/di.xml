        </arguments>
    </virtualType>
    <virtualType name="PayoneCPGooglePayConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_GOOGLEPAY</argument>
        </arguments>
    </virtualType>

    <!-- Apple Pay -->
    <type name="Payone\CommercePlatform\Model\Method\ApplePay">
        <arguments>
            <argument name="valueHandlerPool" xsi:type="object">PayoneCPApplePayValueHandlerPool</argument>
        </arguments>
    </type>
    <virtualType name="PayoneCPApplePayValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">PayoneCPApplePayValueHandler</item>
