        </arguments>
    </virtualType>
    <virtualType name="PayoneCPPayPalConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_PAYPAL</argument>
        </arguments>
    </virtualType>

    <!-- Wero: only for the Wero countries (specificcountry in config.xml) -->
    <type name="Payone\CommercePlatform\Model\Method\Wero">
        <arguments>
            <argument name="valueHandlerPool" xsi:type="object">PayoneCPWeroValueHandlerPool</argument>
            <argument name="validatorPool" xsi:type="object">PayoneCPWeroValidatorPool</argument>
        </arguments>
    </type>
    <virtualType name="PayoneCPWeroValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">PayoneCPWeroValueHandler</item>
