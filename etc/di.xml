    </virtualType>
    <virtualType name="PayoneCPApplePayConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_APPLEPAY</argument>
        </arguments>
    </virtualType>

    <!-- PAYONE Secured Invoice: only for the configured countries (DE/AT, specificcountry in config.xml) -->
    <type name="Payone\CommercePlatform\Model\Method\SecuredInvoice">
        <arguments>
            <argument name="valueHandlerPool" xsi:type="object">PayoneCPSecuredInvoiceValueHandlerPool</argument>
            <argument name="validatorPool" xsi:type="object">PayoneCPSecuredInvoiceValidatorPool</argument>
        </arguments>
    </type>
    <virtualType name="PayoneCPSecuredInvoiceValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">PayoneCPSecuredInvoiceValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPSecuredInvoiceValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
