<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="Payone\CommercePlatform\Api\ClickToPayInterface" type="Payone\CommercePlatform\Service\V1\ClickToPay" />
    <preference for="Payone\CommercePlatform\Api\Data\ClickToPayResponseInterface" type="Payone\CommercePlatform\Service\V1\Data\ClickToPayResponse" />

    <!-- START - PAYMENT METHODS -->
    <!-- Base of all PAYONE payment methods: Magento's Adapter with the PAYONE commands. Never used directly. -->
    <virtualType name="PayoneCPFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Magento\Payment\Block\Info</argument>
            <argument name="commandPool" xsi:type="object">PayoneCPCommandPool</argument>
        </arguments>
    </virtualType>

    <!-- Every payment method needs these 4 blocks (facade = <model> in etc/config.xml, config from payment/<code>/*) -->
    <!-- Credit card -->
    <virtualType name="PayoneCPCreditcardFacade" type="PayoneCPFacade">
        <arguments>
            <argument name="code" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_CREDITCARD</argument>
            <argument name="valueHandlerPool" xsi:type="object">PayoneCPCreditcardValueHandlerPool</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPCreditcardValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">PayoneCPCreditcardValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPCreditcardValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">PayoneCPCreditcardConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPCreditcardConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_CREDITCARD</argument>
        </arguments>
    </virtualType>

    <!-- SEPA direct debit -->
    <virtualType name="PayoneCPDirectDebitFacade" type="PayoneCPFacade">
        <arguments>
            <argument name="code" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_DIRECT_DEBIT</argument>
            <argument name="valueHandlerPool" xsi:type="object">PayoneCPDirectDebitValueHandlerPool</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPDirectDebitValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">PayoneCPDirectDebitValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPDirectDebitValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">PayoneCPDirectDebitConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPDirectDebitConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_DIRECT_DEBIT</argument>
        </arguments>
    </virtualType>

    <!-- PayPal -->
    <virtualType name="PayoneCPPayPalFacade" type="PayoneCPFacade">
        <arguments>
            <argument name="code" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_PAYPAL</argument>
            <argument name="valueHandlerPool" xsi:type="object">PayoneCPPayPalValueHandlerPool</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPPayPalValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">PayoneCPPayPalValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPPayPalValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">PayoneCPPayPalConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPPayPalConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_PAYPAL</argument>
        </arguments>
    </virtualType>

    <!-- Google Pay -->
    <virtualType name="PayoneCPGooglePayFacade" type="PayoneCPFacade">
        <arguments>
            <argument name="code" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_GOOGLEPAY</argument>
            <argument name="valueHandlerPool" xsi:type="object">PayoneCPGooglePayValueHandlerPool</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPGooglePayValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">PayoneCPGooglePayValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPGooglePayValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">PayoneCPGooglePayConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPGooglePayConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_GOOGLEPAY</argument>
        </arguments>
    </virtualType>

    <!-- PAYONE Secured Invoice: additionally shows the payment instructions and is only available for DE/AT, EUR and identical addresses -->
    <virtualType name="PayoneCPSecuredInvoiceFacade" type="PayoneCPFacade">
        <arguments>
            <argument name="code" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_SECURED_INVOICE</argument>
            <argument name="valueHandlerPool" xsi:type="object">PayoneCPSecuredInvoiceValueHandlerPool</argument>
            <argument name="validatorPool" xsi:type="object">PayoneCPSecuredInvoiceValidatorPool</argument>
            <argument name="infoBlockType" xsi:type="string">Payone\CommercePlatform\Block\Info\PaymentInstructions</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPSecuredInvoiceValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">PayoneCPSecuredInvoiceValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPSecuredInvoiceValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">PayoneCPSecuredInvoiceConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPSecuredInvoiceConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_SECURED_INVOICE</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPSecuredInvoiceValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="country" xsi:type="string">PayoneCPSecuredInvoiceCountryValidator</item>
                <item name="currency" xsi:type="string">PayoneCPBnplCurrencyValidator</item>
                <item name="availability" xsi:type="string">Payone\CommercePlatform\Gateway\Validator\BnplAvailabilityValidator</item>
                <item name="global" xsi:type="string">Payone\CommercePlatform\Gateway\Validator\BnplCustomerDataValidator</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPSecuredInvoiceCountryValidator" type="Magento\Payment\Gateway\Validator\CountryValidator">
        <arguments>
            <argument name="config" xsi:type="object">PayoneCPSecuredInvoiceConfig</argument>
        </arguments>
    </virtualType>

    <!-- PAYONE Secured Direct Debit: like Secured Invoice, but without payment instructions and B2B -->
    <virtualType name="PayoneCPSecuredDirectDebitFacade" type="PayoneCPFacade">
        <arguments>
            <argument name="code" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_SECURED_DIRECT_DEBIT</argument>
            <argument name="valueHandlerPool" xsi:type="object">PayoneCPSecuredDirectDebitValueHandlerPool</argument>
            <argument name="validatorPool" xsi:type="object">PayoneCPSecuredDirectDebitValidatorPool</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPSecuredDirectDebitValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">PayoneCPSecuredDirectDebitValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPSecuredDirectDebitValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">PayoneCPSecuredDirectDebitConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPSecuredDirectDebitConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="const">Payone\CommercePlatform\Model\Payone::METHOD_SECURED_DIRECT_DEBIT</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPSecuredDirectDebitValidatorPool" type="Magento\Payment\Gateway\Validator\ValidatorPool">
        <arguments>
            <argument name="validators" xsi:type="array">
                <item name="country" xsi:type="string">PayoneCPSecuredDirectDebitCountryValidator</item>
                <item name="currency" xsi:type="string">PayoneCPBnplCurrencyValidator</item>
                <item name="availability" xsi:type="string">PayoneCPBnplB2CAvailabilityValidator</item>
                <item name="global" xsi:type="string">Payone\CommercePlatform\Gateway\Validator\BnplCustomerDataValidator</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPSecuredDirectDebitCountryValidator" type="Magento\Payment\Gateway\Validator\CountryValidator">
        <arguments>
            <argument name="config" xsi:type="object">PayoneCPSecuredDirectDebitConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPBnplB2CAvailabilityValidator" type="Payone\CommercePlatform\Gateway\Validator\BnplAvailabilityValidator">
        <arguments>
            <argument name="b2bAllowed" xsi:type="boolean">false</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPBnplCurrencyValidator" type="Payone\CommercePlatform\Gateway\Validator\CurrencyValidator">
        <arguments>
            <argument name="allowedCurrencies" xsi:type="array">
                <item name="EUR" xsi:type="string">EUR</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Checkout input → additional_information of the payment (events in etc/events.xml), PayPal has no input -->
    <virtualType name="PayoneCPCreditcardDataAssignObserver" type="Payone\CommercePlatform\Observer\DataAssignObserver">
        <arguments>
            <argument name="additionalInformationKeys" xsi:type="array">
                <item name="pseudocardpan" xsi:type="string">pseudocardpan</item>
                <item name="cardholder" xsi:type="string">cardholder</item>
                <item name="cardtype" xsi:type="string">cardtype</item>
                <item name="cardinputmode" xsi:type="string">cardinputmode</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPDirectDebitDataAssignObserver" type="Payone\CommercePlatform\Observer\DataAssignObserver">
        <arguments>
            <argument name="additionalInformationKeys" xsi:type="array">
                <item name="bank_country" xsi:type="string">bank_country</item>
                <item name="accountholder" xsi:type="string">accountholder</item>
                <item name="iban" xsi:type="string">iban</item>
                <item name="bic" xsi:type="string">bic</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPGooglePayDataAssignObserver" type="Payone\CommercePlatform\Observer\DataAssignObserver">
        <arguments>
            <argument name="additionalInformationKeys" xsi:type="array">
                <item name="payment_token" xsi:type="string">payment_token</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPSecuredInvoiceDataAssignObserver" type="Payone\CommercePlatform\Observer\DataAssignObserver">
        <arguments>
            <argument name="additionalInformationKeys" xsi:type="array">
                <item name="dateofbirth" xsi:type="string">dateofbirth</item>
                <item name="telephone" xsi:type="string">telephone</item>
                <item name="device_token" xsi:type="string">device_token</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPSecuredDirectDebitDataAssignObserver" type="Payone\CommercePlatform\Observer\DataAssignObserver">
        <arguments>
            <argument name="additionalInformationKeys" xsi:type="array">
                <item name="dateofbirth" xsi:type="string">dateofbirth</item>
                <item name="telephone" xsi:type="string">telephone</item>
                <item name="device_token" xsi:type="string">device_token</item>
                <item name="accountholder" xsi:type="string">accountholder</item>
                <item name="iban" xsi:type="string">iban</item>
            </argument>
        </arguments>
    </virtualType>
    <!-- END - PAYMENT METHODS -->

    <!-- START - PAYMENT COMMANDS (executed by Magento\Payment\Model\Method\Adapter, only if can_<command> is set in config.xml) -->
    <virtualType name="PayoneCPCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="authorize" xsi:type="string">PayoneCPAuthorizeCommand</item>
                <item name="initialize" xsi:type="string">PayoneCPInitializeCommand</item>
                <item name="capture" xsi:type="string">PayoneCPCaptureCommand</item>
                <item name="refund" xsi:type="string">PayoneCPRefundCommand</item>
                <item name="void" xsi:type="string">PayoneCPCancelCommand</item>
                <item name="cancel" xsi:type="string">PayoneCPCancelCommand</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Base of all payment commands: client, validator and error message mapper are always the same -->
    <virtualType name="PayoneCPGatewayCommand" type="Magento\Payment\Gateway\Command\GatewayCommand">
        <arguments>
            <argument name="client" xsi:type="object">Payone\CommercePlatform\Gateway\Http\Client</argument>
            <argument name="validator" xsi:type="object">Payone\CommercePlatform\Gateway\Validator\ResponseValidator</argument>
            <argument name="errorMessageMapper" xsi:type="object">Payone\CommercePlatform\Gateway\ErrorMapper\PassthroughMessageMapper</argument>
        </arguments>
    </virtualType>

    <!-- authorize (direct methods, e.g. SEPA) and initialize (redirect methods, can_initialize = 1): same request, POST /commerce-cases with autoExecuteOrder -->
    <virtualType name="PayoneCPAuthorizeCommand" type="PayoneCPGatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">PayoneCPPaymentRequestBuilder</argument>
            <argument name="transferFactory" xsi:type="object">PayoneCPPaymentTransferFactory</argument>
            <argument name="handler" xsi:type="object">PayoneCPAuthorizeHandler</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPInitializeCommand" type="PayoneCPAuthorizeCommand">
        <arguments>
            <argument name="handler" xsi:type="object">PayoneCPInitializeHandler</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPPaymentRequestBuilder" type="Magento\Payment\Gateway\Request\BuilderComposite">
        <arguments>
            <argument name="builders" xsi:type="array">
                <item name="context" xsi:type="string">Payone\CommercePlatform\Gateway\Request\OrderContextBuilder</item>
                <item name="commerce_case" xsi:type="string">Payone\CommercePlatform\Gateway\Request\CommerceCaseBuilder</item>
                <item name="checkout" xsi:type="string">Payone\CommercePlatform\Gateway\Request\CheckoutBuilder</item>
                <item name="order" xsi:type="string">Payone\CommercePlatform\Gateway\Request\OrderBuilder</item>
                <item name="payment_method_specific" xsi:type="string">Payone\CommercePlatform\Gateway\Request\PaymentMethodSpecificBuilder</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPPaymentTransferFactory" type="Payone\CommercePlatform\Gateway\Http\TransferFactory">
        <arguments>
            <argument name="endpoint" xsi:type="string">/v1/{merchantId}/commerce-cases</argument>
            <argument name="httpMethod" xsi:type="string">POST</argument>
            <argument name="requestName" xsi:type="string">OneStep</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPAuthorizeHandler" type="Magento\Payment\Gateway\Response\HandlerChain">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="payment_ids" xsi:type="string">Payone\CommercePlatform\Gateway\Response\PaymentIdsHandler</item>
                <item name="redirect_url" xsi:type="string">Payone\CommercePlatform\Gateway\Response\RedirectUrlHandler</item>
                <item name="payment_instructions" xsi:type="string">Payone\CommercePlatform\Gateway\Response\PaymentInstructionsHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPInitializeHandler" type="Magento\Payment\Gateway\Response\HandlerChain">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="payment_ids" xsi:type="string">Payone\CommercePlatform\Gateway\Response\PaymentIdsHandler</item>
                <item name="redirect_url" xsi:type="string">Payone\CommercePlatform\Gateway\Response\RedirectUrlHandler</item>
                <item name="pending_state" xsi:type="string">Payone\CommercePlatform\Gateway\Response\PendingStateHandler</item>
            </argument>
        </arguments>
    </virtualType>

    <!-- Payment method specific input: one builder per payment method -->
    <type name="Payone\CommercePlatform\Gateway\Request\PaymentMethodSpecificBuilder">
        <arguments>
            <argument name="builders" xsi:type="array">
                <item name="payone_cp_creditcard" xsi:type="object">Payone\CommercePlatform\Gateway\Request\PaymentMethod\CreditcardBuilder</item>
                <item name="payone_cp_directdebit" xsi:type="object">Payone\CommercePlatform\Gateway\Request\PaymentMethod\DirectDebitBuilder</item>
                <item name="payone_cp_paypal" xsi:type="object">Payone\CommercePlatform\Gateway\Request\PaymentMethod\PayPalBuilder</item>
                <item name="payone_cp_googlepay" xsi:type="object">Payone\CommercePlatform\Gateway\Request\PaymentMethod\GooglePayBuilder</item>
                <item name="payone_cp_securedinvoice" xsi:type="object">Payone\CommercePlatform\Gateway\Request\PaymentMethod\SecuredInvoiceBuilder</item>
                <item name="payone_cp_secureddirectdebit" xsi:type="object">Payone\CommercePlatform\Gateway\Request\PaymentMethod\SecuredDirectDebitBuilder</item>
            </argument>
        </arguments>
    </type>

    <virtualType name="PayoneCPCaptureCommand" type="PayoneCPGatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">PayoneCPCaptureRequestBuilder</argument>
            <argument name="transferFactory" xsi:type="object">PayoneCPCaptureTransferFactory</argument>
            <argument name="handler" xsi:type="object">PayoneCPCaptureHandler</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPCaptureHandler" type="Magento\Payment\Gateway\Response\HandlerChain">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="transaction_id" xsi:type="string">Payone\CommercePlatform\Gateway\Response\TransactionIdHandler</item>
                <item name="payment_instructions" xsi:type="string">Payone\CommercePlatform\Gateway\Response\PaymentInstructionsHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPCaptureRequestBuilder" type="Magento\Payment\Gateway\Request\BuilderComposite">
        <arguments>
            <argument name="builders" xsi:type="array">
                <item name="context" xsi:type="string">Payone\CommercePlatform\Gateway\Request\OrderContextBuilder</item>
                <item name="references" xsi:type="string">Payone\CommercePlatform\Gateway\Request\PaymentReferencesBuilder</item>
                <item name="capture" xsi:type="string">Payone\CommercePlatform\Gateway\Request\CaptureBuilder</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPCaptureTransferFactory" type="Payone\CommercePlatform\Gateway\Http\TransferFactory">
        <arguments>
            <argument name="endpoint" xsi:type="string">/v1/{merchantId}/commerce-cases/{commerceCaseId}/checkouts/{checkoutId}/payment-executions/{paymentExecutionId}/capture</argument>
            <argument name="httpMethod" xsi:type="string">POST</argument>
            <argument name="requestName" xsi:type="string">Capture</argument>
        </arguments>
    </virtualType>

    <virtualType name="PayoneCPRefundCommand" type="PayoneCPGatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">PayoneCPRefundRequestBuilder</argument>
            <argument name="transferFactory" xsi:type="object">PayoneCPRefundTransferFactory</argument>
            <argument name="handler" xsi:type="object">Payone\CommercePlatform\Gateway\Response\TransactionIdHandler</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPRefundRequestBuilder" type="Magento\Payment\Gateway\Request\BuilderComposite">
        <arguments>
            <argument name="builders" xsi:type="array">
                <item name="context" xsi:type="string">Payone\CommercePlatform\Gateway\Request\OrderContextBuilder</item>
                <item name="references" xsi:type="string">Payone\CommercePlatform\Gateway\Request\PaymentReferencesBuilder</item>
                <item name="refund" xsi:type="string">Payone\CommercePlatform\Gateway\Request\RefundBuilder</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPRefundTransferFactory" type="Payone\CommercePlatform\Gateway\Http\TransferFactory">
        <arguments>
            <argument name="endpoint" xsi:type="string">/v1/{merchantId}/commerce-cases/{commerceCaseId}/checkouts/{checkoutId}/payment-executions/{paymentExecutionId}/refund</argument>
            <argument name="httpMethod" xsi:type="string">POST</argument>
            <argument name="requestName" xsi:type="string">Refund</argument>
        </arguments>
    </virtualType>

    <virtualType name="PayoneCPCancelCommand" type="PayoneCPGatewayCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">PayoneCPCancelRequestBuilder</argument>
            <argument name="transferFactory" xsi:type="object">PayoneCPCancelTransferFactory</argument>
            <argument name="handler" xsi:type="object">Payone\CommercePlatform\Gateway\Response\TransactionIdHandler</argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPCancelRequestBuilder" type="Magento\Payment\Gateway\Request\BuilderComposite">
        <arguments>
            <argument name="builders" xsi:type="array">
                <item name="context" xsi:type="string">Payone\CommercePlatform\Gateway\Request\OrderContextBuilder</item>
                <item name="references" xsi:type="string">Payone\CommercePlatform\Gateway\Request\PaymentReferencesBuilder</item>
                <item name="cancel" xsi:type="string">Payone\CommercePlatform\Gateway\Request\CancelBuilder</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="PayoneCPCancelTransferFactory" type="Payone\CommercePlatform\Gateway\Http\TransferFactory">
        <arguments>
            <argument name="endpoint" xsi:type="string">/v1/{merchantId}/commerce-cases/{commerceCaseId}/checkouts/{checkoutId}/payment-executions/{paymentExecutionId}/cancel</argument>
            <argument name="httpMethod" xsi:type="string">POST</argument>
            <argument name="requestName" xsi:type="string">CancelPayment</argument>
        </arguments>
    </virtualType>
    <!-- END - PAYMENT COMMANDS -->

    <!-- START - SERVICE COMMANDS (API calls outside of payment operations, return an ArrayResult) -->
    <virtualType name="PayoneCPServiceCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="get_jwt" xsi:type="string">PayoneCPGetJwtCommand</item>
                <item name="get_checkout_details" xsi:type="string">PayoneCPGetCheckoutDetailsCommand</item>
            </argument>
        </arguments>
    </virtualType>

    <virtualType name="PayoneCPGetJwtCommand" type="Payone\CommercePlatform\Gateway\Command\ResultCommand">
        <arguments>
            <argument name="requestBuilder" xsi:type="object">Payone\CommercePlatform\Gateway\Request\GetJwtBuilder</argument>
