<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Puts webhooks whose processing failed back into the queue -->
        <job name="payone_cp_webhook_retry" instance="Payone\CommercePlatform\Cron\RetryWebhooks" method="execute">
            <schedule>*/5 * * * *</schedule>
        </job>
        <!-- Pay in Store: marks paid orders as paid, cancels unpaid ones after the configured number of days -->
        <job name="payone_cp_payinstore_status" instance="Payone\CommercePlatform\Cron\CheckPayInStoreOrders" method="execute">
            <schedule>*/15 * * * *</schedule>
        </job>
        <!-- Deletes API and webhook log entries after the configured number of days -->
        <job name="payone_cp_clean_logs" instance="Payone\CommercePlatform\Cron\CleanLogs" method="execute">
            <schedule>30 3 * * *</schedule>
        </job>
    </group>
</config>
