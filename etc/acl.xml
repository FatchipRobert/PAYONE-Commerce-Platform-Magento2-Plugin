<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Payone_CommercePlatform::payone_cp" title="Payone" sortOrder="500">
                    <resource id="Payone_CommercePlatform::payone_cp_orders" title="Orders" sortOrder="10" />
                    <resource id="Payone_CommercePlatform::payone_cp_configuration" title="Configuration" sortOrder="20">
                        <resource id="Payone_CommercePlatform::payone_cp_configuration_general" title="General" sortOrder="10" />
                        <resource id="Payone_CommercePlatform::payone_cp_configuration_payment" title="Payment" sortOrder="20" />
                    </resource>
                    <resource id="Payone_CommercePlatform::payone_cp_protocol" title="Logs" sortOrder="30">
                        <resource id="Payone_CommercePlatform::payone_cp_protocol_api" title="Api" sortOrder="10" />
                        <resource id="Payone_CommercePlatform::payone_cp_protocol_webhook" title="Webhook" sortOrder="20" />
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
