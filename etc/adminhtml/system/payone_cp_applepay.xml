<include xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_include.xsd">
    <group id="payone_cp_applepay" translate="label" type="text" sortOrder="45" showInDefault="1" showInWebsite="1" showInStore="1">
        <label>Apple Pay</label>
        <field id="active" translate="label" type="select" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Enabled</label>
            <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
            <config_path>payment/payone_cp_applepay/active</config_path>
        </field>
        <field id="title" translate="label" type="text" sortOrder="10" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Title</label>
            <config_path>payment/payone_cp_applepay/title</config_path>
        </field>
        <field id="automatic_capture" translate="label" type="select" sortOrder="20" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Automatic capture</label>
            <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
            <config_path>payment/payone_cp_applepay/automatic_capture</config_path>
        </field>
        <field id="instructions" translate="label" type="textarea" sortOrder="30" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Instructions</label>
            <config_path>payment/payone_cp_applepay/instructions</config_path>
        </field>
        <field id="merchant_identifier" translate="label,comment" type="text" sortOrder="40" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Apple Pay Merchant ID</label>
            <comment><![CDATA[Merchant identifier from your Apple Developer account, e.g. merchant.com.example.shop]]></comment>
        </field>
        <field id="certificate_file" translate="label,comment" type="file" sortOrder="50" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Certificate file</label>
            <backend_model>PayoneCPApplePayCertificateFileBackend</backend_model>
            <frontend_model>Payone\CommercePlatform\Block\Adminhtml\Config\Form\Field\EncryptedFile</frontend_model>
            <comment><![CDATA[Apple Pay Merchant Identity Certificate (e.g. merchant_id.cer, DER or PEM format). Used for the merchant validation of the Apple Pay session, stored encrypted.]]></comment>
        </field>
        <field id="private_key_file" translate="label,comment" type="file" sortOrder="60" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Private key file</label>
            <backend_model>PayoneCPApplePayPrivateKeyFileBackend</backend_model>
            <frontend_model>Payone\CommercePlatform\Block\Adminhtml\Config\Form\Field\EncryptedFile</frontend_model>
            <comment><![CDATA[Private key of the Merchant Identity Certificate in PEM format, stored encrypted.]]></comment>
        </field>
        <field id="private_key_password" translate="label,comment" type="obscure" sortOrder="70" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Private Key Password</label>
            <backend_model>Magento\Config\Model\Config\Backend\Encrypted</backend_model>
            <comment><![CDATA[Only if the private key is encrypted.]]></comment>
        </field>
        <field id="display_name" translate="label,comment" type="text" sortOrder="80" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Store Name</label>
            <comment><![CDATA[Will be displayed in the Apple Pay payment sheet. Store name from general config will be used if not given.]]></comment>
        </field>
        <field id="supported_networks" translate="label" type="multiselect" sortOrder="90" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Card networks</label>
            <source_model>Payone\CommercePlatform\Model\Source\ApplePayNetworks</source_model>
        </field>
        <field id="min_order_total" translate="label" type="text" sortOrder="100" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Minimum Order Total</label>
            <config_path>payment/payone_cp_applepay/min_order_total</config_path>
        </field>
        <field id="max_order_total" translate="label" type="text" sortOrder="110" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Maximum Order Total</label>
            <config_path>payment/payone_cp_applepay/max_order_total</config_path>
        </field>
        <field id="sort_order" translate="label" type="text" sortOrder="120" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Sort Order</label>
            <config_path>payment/payone_cp_applepay/sort_order</config_path>
        </field>
    </group>
</include>
