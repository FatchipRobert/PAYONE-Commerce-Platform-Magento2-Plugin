<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/guest-carts/:cartId/payone-getJwt" method="POST">
        <service class="Payone\CommercePlatform\Api\ClickToPayInterface" method="getJwtGuest"/>
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>

    <route url="/V1/carts/mine/payone-getJwt" method="POST">
        <service class="Payone\CommercePlatform\Api\ClickToPayInterface" method="getJwt"/>
        <resources>
            <resource ref="self" />
        </resources>
        <data>
            <parameter name="cartId" force="true">%cart_id%</parameter>
        </data>
    </route>
</routes>
