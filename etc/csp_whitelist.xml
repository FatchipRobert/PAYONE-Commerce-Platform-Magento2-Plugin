<csp_whitelist xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Csp:etc/csp_whitelist.xsd">
    <policies>
        <policy id="script-src">
            <values>
                <value id="payone_cp_ccv2_script" type="host">*.tokenization.secure.payone.com</value>
                <value id="payone_cp_googlepay_script" type="host">pay.google.com</value>
                <value id="payone_cp_payla_script" type="host">d.payla.io</value>
            </values>
        </policy>
        <policy id="style-src">
            <values>
                <value id="payone_cp_payla_css" type="host">d.payla.io</value>
                <value id="payone_cp_payla_css2" type="host">dr.payla.io</value>
            </values>
        </policy>
        <policy id="frame-src">
            <values>
                <value id="payone_cp_ccv2_script" type="host">*.tokenization.secure.payone.com</value>
                <value id="payone_cp_googlepay_frame" type="host">pay.google.com</value>
            </values>
        </policy>
        <policy id="connect-src">
            <values>
                <value id="payone_cp_ccv2_connect" type="host">*.tokenization.secure.payone.com</value>
                <value id="payone_cp_googlepay_connect" type="host">pay.google.com</value>
                <value id="payone_cp_googlepay_connect_google" type="host">google.com</value>
                <value id="payone_cp_googlepay_connect_www" type="host">www.google.com</value>
            </values>
        </policy>
        <policy id="img-src">
            <values>
                <value id="payone_cp_googlepay_img" type="host">www.gstatic.com</value>
            </values>
        </policy>
    </policies>
</csp_whitelist>
