<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Communication/etc/communication.xsd">
    <!-- Received webhook (entity_id in payone_cp_protocol_webhook) that still has to be processed -->
    <topic name="payone_cp.webhook.process" request="string">
        <handler name="payone_cp.webhook.process" type="Payone\CommercePlatform\Model\Webhook\QueueConsumer" method="process" />
    </topic>
</config>
