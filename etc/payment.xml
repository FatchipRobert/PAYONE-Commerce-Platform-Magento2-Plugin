<payment xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Payment:etc/payment.xsd">
    <groups>
        <group id="payone_cp">
            <label>Payone Commerce Plattform Payment Methods</label>
        </group>
    </groups>
    <methods>
        <method name="payone_cp_creditcard">
            <allow_multiple_address>0</allow_multiple_address>
        </method>
        <method name="payone_cp_directdebit">
            <allow_multiple_address>0</allow_multiple_address>
        </method>
        <method name="payone_cp_paypal">
            <allow_multiple_address>0</allow_multiple_address>
        </method>
        <method name="payone_cp_googlepay">
            <allow_multiple_address>0</allow_multiple_address>
        </method>
        <method name="payone_cp_applepay">
            <allow_multiple_address>0</allow_multiple_address>
        </method>
        <method name="payone_cp_securedinvoice">
            <allow_multiple_address>0</allow_multiple_address>
        </method>
        <method name="payone_cp_secureddirectdebit">
            <allow_multiple_address>0</allow_multiple_address>
        </method>
    </methods>
</payment>
